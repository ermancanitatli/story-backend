{
  "extends": "./tsconfig.json",
  // include olmadan TypeScript rootDir'i derlenen dosyaların ortak kökünden çıkarır.
  // public/panel-assets/vendors/tinymce altında .ts uzantılı skin dosyaları var; onlar
  // derlemeye girdiği anda ortak kök proje köküne kayıyor ve çıktı dist/main.js yerine
  // dist/src/main.js oluyordu. ecosystem.config.js ise sabit 'dist/main.js' çalıştırdığı
  // için container "Script not found" ile crash-loop'a giriyordu.
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "e2e",
    "scripts",
    "public",
    "playwright.config.ts",
    "**/*spec.ts"
  ]
}
